target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

preamble{=
  #include <math.h>
=}



reactor Tilt {
  input x: float;
  input y: float;
  input z: float;

  output pitch: float;
  output roll: float;

  reaction (x, y, z) -> pitch, roll {=
    lf_set(roll,atan2((double)y->value,(double)z->value) * 57.3);
    lf_set(pitch,atan2((double)(-x->value) , sqrt(y->value * y-> value + z->value * z->value)) * 57.3);
  =}

}