/**
 * Blink the default LED on the
 * <a href="https://www.pololu.com/docs/0J86">Pololu 3pi+ 2040 robot</a>.
 * @author Abhi Gundrala
 * @author Edward A. Lee
 */
target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

import Display from "lib/Display.lf"

preamble {=
  #include <imu.h>
  #include <stdio.h>
  #include <pico/stdlib.h>
  #include <hardware/gpio.h>
=}

main reactor {
  timer t(0, 250 ms)
  display = new Display()

  reaction(startup) {=

  =}

  reaction(t) -> display.line0 {=

    if(sio_hw->gpio_in & (1u << 25)){
      lf_set(display.line0, "OFF");
    }
    else{
      lf_set(display.line0, "ON");
    }
  =}
}
